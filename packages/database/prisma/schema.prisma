// ButterCupp database schema. Source of truth: prds/master-prd.md §8.
//
// Embedding dimension: vector(384), matching in-process Xenova/all-MiniLM-L6-v2.
// This is the ONE dimension used by Memory.embedding and MemorySummary.embedding.
// Changing it later requires a migration and a full re-embed of every row.
//
// Naming: enums use PascalCase types, snake_case values (matching PRD §8 text).
// Every table has createdAt; mutable tables also have updatedAt.

generator client {
  provider        = "prisma-client-js"
  // Match Pellow's proven Amplify setup EXACTLY: native library engine +
  // driverAdapters preview (NOT engineType="client"/WASM). The WASM query
  // compiler ships query_compiler_bg.wasm as a readFileSync'd data file that
  // Amplify's WEB_COMPUTE bundler does not co-locate with the client, causing
  // "ENOENT query_compiler_bg.wasm" at runtime. The native .so.node engine IS
  // traced and bundled (with the binaryTargets below + the @prisma/engines
  // copy in amplify.yml). The client is still constructed with a PrismaPg
  // adapter (see packages/database/src/client.ts).
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums (closed sets from PRD §8)
// =============================================================================

enum SubscriptionTier {
  free
  premium
  pro
}

enum ContentRating {
  sfw
  mature
}

enum Visibility {
  private
  public
}

enum CharacterStyle {
  // enum value cannot start with a digit, so "3d" is spelled threeD in the
  // Prisma enum. UI labels it "3D".
  realistic
  threeD
  anime
}

enum ModerationStatus {
  pending
  approved
  rejected
}

enum MemoryTier {
  hot
  warm
  cold
}

enum MediaKind {
  image
  voice
  video
}

enum MediaStatus {
  queued
  processing
  ready
  failed
}

enum TokenReason {
  purchase
  image_gen
  voice_gen
  premium_msg
  grant
  gallery_unlock
}

enum MessageRole {
  user
  assistant
  system
}

enum AgeVerificationLevel {
  none
  self_declared
  vendor_verified
}

// =============================================================================
// Users, auth, age & compliance
// =============================================================================

model User {
  id                     String               @id @default(uuid())
  email                  String               @unique
  passwordHash           String?
  oauthProvider          String?
  googleId               String?              @unique
  dob                    DateTime?
  jurisdiction           String?
  subscriptionTier       SubscriptionTier     @default(free)
  tokenBalance           Int                  @default(0)
  // Phase 20: lifetime free-trial counter (see FREE_MESSAGE_LIMIT). Additive.
  freeMessagesUsed       Int                  @default(0)
  ageVerifiedAt          DateTime?
  ageVerificationLevel   AgeVerificationLevel @default(none)
  // Phase 34: email verification (Feature C). Null = unverified; password
  // signups start null and are gated by the (protected) layout via
  // requireEmailVerified(). Google OAuth users are auto-verified at both
  // create and link time. Additive/nullable so pre-existing rows are safe;
  // the prod backfill (Manual step) treats existing users as verified.
  emailVerifiedAt        DateTime?
  tosAcceptedAt          DateTime?
  privacyAcceptedAt      DateTime?
  // Phase 29: versioned consent gate. consentAcceptedAt is the timestamp of
  // the most recent accept; acceptedPolicyVersion is compared against
  // POLICY_VERSION (frontend/lib/consent.ts) to decide whether the gate
  // reshows. Both additive/nullable: null acceptedPolicyVersion means "never
  // accepted the current version" and the modal shows.
  consentAcceptedAt      DateTime?
  acceptedPolicyVersion  String?
  // Phase 24: once-flag for the magical onboarding wizard. Lives on User
  // (not in JSON) because the (protected) layout reads it on every request;
  // it must stay a single cheap column read. Null means "run the wizard".
  completedOnboardingAt  DateTime?
  // Login-device tracking. Denormalized last-login snapshot (no per-event
  // history table on purpose - the admin only needs to answer "what device
  // did this user last sign in from?" in a single row read alongside the
  // existing User list query). Populated by every auth surface that mints a
  // fresh session cookie (password login, signup, Google OAuth,
  // magic-link consume, reset-password). All three columns are additive and
  // nullable so pre-existing rows and any auth code path that fails to pass
  // a request context stay safe.
  //   - lastLoginDeviceType: coarse bucket for the admin table column, one
  //     of "mobile" | "tablet" | "desktop" | "unknown". Kept as a plain
  //     String (not an enum) so the classifier can grow without a migration.
  //   - lastLoginUserAgent: raw UA string retained for the admin detail page
  //     (support debugging). Truncated to 512 chars at write time.
  //   - lastLoginAt: session-issue timestamp; distinct from updatedAt (which
  //     bumps on any User row write).
  lastLoginAt            DateTime?
  lastLoginDeviceType    String?
  lastLoginUserAgent     String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  characters             Character[]           @relation("CharacterOwner")
  ageVerifications       AgeVerification[]
  conversations          Conversation[]
  memories               Memory[]
  memorySummaries        MemorySummary[]
  relationshipStates     RelationshipState[]
  subscription           Subscription?
  tokenLedger            TokenLedger[]
  mediaAssets            MediaAsset[]
  crisisEvents           CrisisEvent[]
  magicLinks             MagicLink[]
  reelLikes              ReelLike[]
  profile                UserProfile?
  // Phase 30: memory graph back-relations (see model MemoryEntity / MemoryEdge
  // below). Additive; every read/write on these is also scoped by characterId.
  memoryEntities         MemoryEntity[]
  memoryEdges            MemoryEdge[]
  // Phase 30: user-set conversational rulebook (see model UserRule below).
  userRules              UserRule[]
  unlockedMedia          UserUnlockedMedia[]
}

// Phase 24: additive 1:1 onboarding profile. Kept separate from User because
// (a) these fields are optional and evolve independently of auth/billing
// fields, keeping the hot User row lean, (b) a dedicated table lets us
// index/extend taste fields later without more User columns, (c) Json for
// the free-form taste blob avoids a column explosion while the shape
// stabilizes. Every field is nullable; there is no backfill, so this
// migration is safe for existing users (they get profile = null until they
// complete onboarding once).
model UserProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  displayName  String?
  gender       String?
  // Free-form taste blob: { vibe, interests: string[], companionGoal }.
  // Kept as Json to avoid a column explosion while the shape stabilizes.
  preferences  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgeVerification {
  id           String               @id @default(uuid())
  userId       String
  provider     String
  level        AgeVerificationLevel
  status       String
  evidenceRef  String?
  verifiedAt   DateTime?
  createdAt    DateTime             @default(now())

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MagicLink {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  purpose     String    @default("login")
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// =============================================================================
// Characters (system-owned and user-owned) + versions + assets
// =============================================================================

model Character {
  id                String            @id @default(uuid())
  ownerUserId       String?
  name              String
  age               Int
  gender            String
  bio               String
  tags              String[]
  style             CharacterStyle
  contentRating     ContentRating     @default(sfw)
  visibility        Visibility        @default(private)
  moderationStatus  ModerationStatus  @default(pending)
  currentVersionId  String?
  popularityScore   Float             @default(0)
  // Free-text home/city shown on cards and reels (e.g. "Lisbon, Portugal").
  location          String?
  // Stable natural key for system-owned personas (ownerUserId IS NULL). Set
  // by sync-personas.ts to "persona-<index>" derived from the seed image URL
  // /personas/<index>.webp so re-seeding is idempotent regardless of any
  // canonical-name rename. NULL for user-created characters. Enforced as a
  // partial unique index (see migration add_character_seed_key). Locked
  // decision, see Plans/cursor-prompt/35-major-fixes-batch.md #A.
  seedKey           String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  owner             User?             @relation("CharacterOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  versions          CharacterVersion[] @relation("CharacterVersions")
  currentVersion    CharacterVersion?  @relation("CharacterCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  conversations     Conversation[]
  media             CharacterMedia[]

  @@index([visibility, moderationStatus])
  @@index([contentRating])
  @@index([popularityScore])
  @@index([ownerUserId])
}

model CharacterVersion {
  id                       String            @id @default(uuid())
  characterId              String
  versionNo                Int
  personality              String
  backstory                String
  behavioralInstructions   String
  greeting                 String
  appearanceSheetId        String?
  voiceProfileId           String?
  systemPromptSnapshot     String
  createdAt                DateTime          @default(now())

  character                Character         @relation("CharacterVersions", fields: [characterId], references: [id], onDelete: Cascade)
  appearanceSheet          AppearanceSheet?  @relation(fields: [appearanceSheetId], references: [id], onDelete: SetNull)
  voiceProfile             VoiceProfile?     @relation(fields: [voiceProfileId], references: [id], onDelete: SetNull)
  currentOf                Character[]       @relation("CharacterCurrentVersion")
  conversations            Conversation[]

  @@unique([characterId, versionNo])
  @@index([characterId])
}

model AppearanceSheet {
  id                  String   @id @default(uuid())
  traits              Json
  stylePrompt         String
  negativePrompt      String
  referenceImageKeys  String[]
  loraRef             String?
  createdAt           DateTime @default(now())

  versions            CharacterVersion[]
}

model CharacterLora {
  id                 String   @id @default(uuid())
  characterId        String
  characterVersionId String
  status             String   @default("pending") // pending|building|training|validating|ready|rejected|failed
  s3Key              String?
  triggerToken       String?
  baseModel          String   @default("realvisxl_v5") // realvisxl_v5 | juggernaut_xl_v9
  rank               Int      @default(32)
  checkpointStep     Int?
  arcfaceScore       Float?
  datasetKey         String?
  error              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([characterId])
  @@index([status])
}

model VoiceProfile {
  id          String   @id @default(uuid())
  provider    String
  voiceId     String
  params      Json
  previewKey  String?
  createdAt   DateTime @default(now())

  versions    CharacterVersion[]
}

// =============================================================================
// Conversations, messages, memory
// =============================================================================

model Conversation {
  id                   String            @id @default(uuid())
  userId               String
  characterId          String
  characterVersionId   String
  lastMessageAt        DateTime?
  messageCount         Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  character            Character         @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterVersion     CharacterVersion  @relation(fields: [characterVersionId], references: [id], onDelete: Restrict)
  messages             Message[]

  @@unique([userId, characterId])
  @@index([userId, lastMessageAt])
  @@index([characterId])
}

model Message {
  id              String       @id @default(uuid())
  conversationId  String
  role            MessageRole
  content         String
  mediaAssetId    String?
  tokenCost       Int?
  createdAt       DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mediaAsset      MediaAsset?  @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

// pgvector column declared as Unsupported so Prisma passes it through raw.
// The vector index (HNSW cosine) is added by the accompanying migration SQL.
model Memory {
  id                String                       @id @default(uuid())
  userId            String
  characterId       String
  content           String
  category          String
  embedding         Unsupported("vector(384)")?
  tier              MemoryTier                   @default(hot)
  salience          Float                        @default(0.5)
  importance        Float                        @default(0.5)
  confidence        Float                        @default(1.0)
  emotionalValence  Float                        @default(0.0)
  pinned            Boolean                      @default(false)
  accessCount       Int                          @default(0)
  lastAccessedAt    DateTime?
  validUntil        DateTime?
  sourceMessageId   String?
  // Phase 23: sha256 of the normalized content. Nullable/additive so old rows
  // pre-migration keep working. Combined with (userId, characterId,
  // sourceMessageId) it makes concurrent extractor invocations for the same
  // turn idempotent on top of the existing Jaccard 0.6 dedup.
  contentHash       String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  user              User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, characterId])
  @@index([userId, characterId, tier])
  @@index([userId, characterId, sourceMessageId])
}

// Phase 23: append-only visibility for terminal memory-pipeline failures.
// The extractor and compactor never throw into the reply path; a persistent
// failure lands here so an operator can query it and alert on volume.
model MemoryDeadLetter {
  id               String   @id @default(uuid())
  userId           String?
  characterId      String?
  sourceMessageId  String?
  stage            String
  error            String
  createdAt        DateTime @default(now())

  @@index([stage, createdAt])
  @@index([userId, characterId])
}

model MemorySummary {
  id           String                       @id @default(uuid())
  userId       String
  characterId  String
  periodStart  DateTime
  periodEnd    DateTime
  summary      String
  themes       String[]
  sentiment    String?
  keyEvents    Json?
  embedding    Unsupported("vector(384)")?
  createdAt    DateTime                     @default(now())

  user         User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, characterId])
}

model RelationshipState {
  id              String    @id @default(uuid())
  userId          String
  characterId     String
  affectionLevel  Int       @default(0)
  milestones      String[]
  mood            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
}

// =============================================================================
// Billing, tokens, media
// =============================================================================

model Subscription {
  id                String            @id @default(uuid())
  userId            String            @unique
  provider          String
  tier              SubscriptionTier  @default(free)
  // Phase 20: duration-pass plan. Null = user never bought a pass. Values:
  // "free" | "daily" | "weekly" | "monthly" (see backend plans.ts).
  plan              String?
  status            String            @default("inactive")
  currentPeriodEnd  DateTime?
  externalId        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider, status])
}

// Per-provider webhook dedupe. INSERT..ON CONFLICT on (provider, eventId) is
// the cross-instance idempotency primitive; a duplicate event fails the
// insert and the shared handler short-circuits.
model WebhookEvent {
  id         String   @id @default(uuid())
  provider   String
  eventId    String
  eventType  String
  payload    Json
  createdAt  DateTime @default(now())

  @@unique([provider, eventId])
  @@index([createdAt])
}

// Daily/monthly counters for tier limit enforcement (messages, images,
// voice). Period is a bucket key like "2026-07" or "2026-07-30".
model UsageCounter {
  id          String   @id @default(uuid())
  userId      String
  counterType String
  period      String
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, counterType, period])
  @@index([userId])
}

model TokenLedger {
  id            String       @id @default(uuid())
  userId        String
  delta         Int
  reason        TokenReason
  balanceAfter  Int
  refId         String?
  createdAt     DateTime     @default(now())

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model MediaAsset {
  id            String       @id @default(uuid())
  userId        String
  characterId   String?
  kind          MediaKind
  s3Key         String?
  status        MediaStatus  @default(queued)
  jobId         String?
  meta          Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([jobId])
  @@index([characterId, kind])
  @@index([userId, kind])
}

// =============================================================================
// Safety, audit, analytics, flags
// =============================================================================

model CrisisEvent {
  id         String   @id @default(uuid())
  userId     String
  level      Int
  trigger    String
  action     String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([level])
}

// AuditLog intentionally has NO foreign-key relation to User: audit rows must
// survive user deletion. userId/actorId are stored as opaque strings.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  actorId    String?
  action     String
  resource   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  userId     String?
  name       String
  props      Json?
  createdAt  DateTime @default(now())

  @@index([name])
  @@index([userId])
  @@index([createdAt])
}

model FeatureFlag {
  id        String   @id @default(uuid())
  key       String   @unique
  enabled   Boolean  @default(false)
  rollout   Int      @default(0)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A user's like on a reel. reelId is a CharacterMedia id when the reel is
// DB-backed, or a manifest id ("1".."8") when it falls back to the static
// manifest. Either way it is a plain string, not a foreign key. The
// unique(userId, reelId) makes a like idempotent so the displayed count =
// base likes + COUNT(rows) cannot be inflated by one user.
model ReelLike {
  id        String   @id @default(uuid())
  userId    String
  reelId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reelId])
  @@index([reelId])
}

enum CharacterMediaKind {
  image
  video
}

// Canonical media store for a persona: every image and reel/video a character
// owns lives here as a row. `url` is the stored link (an S3/CloudFront URL in
// production, a /public path in local dev). One persona has many media; this
// is the table that lets a character carry multiple images AND multiple reels.
//
// =============================================================================
// HIDDEN MEDIA CONVENTION (permanent, not a one-time cleanup, read this first)
// =============================================================================
// `hidden` marks a row as retired from every user-facing surface while
// PRESERVING it (in the DB and in S3/disk) for audit/history. Hiding is
// additive and reversible by design:
//   - Hidden rows are NEVER deleted, from Postgres, S3, or local disk.
//   - Hidden rows MUST NEVER be selected/rendered by ANY read site. Every
//     query that lists CharacterMedia for display purposes (chat page,
//     PersonaPanel, CharacterCard, gallery/discover grid, dashboard recents,
//     public character detail, marketing landing, reels, and anything added
//     later) MUST filter `hidden: false` (or an equivalent explicit
//     exclusion) in its `where` clause. There is no such thing as a read site
//     that is exempt from this rule.
//   - This was introduced when the stock/placeholder `/personas/N.webp`
//     reference images (seeded only to bootstrap face-consistency generation,
//     never real generated content) were hidden in favor of real
//     Juggernaut-generated images. The same convention applies to any future
//     media that needs to be retired without losing history.
// If you are adding a new query against CharacterMedia, assume you must add
// `hidden: false` to it unless you have an explicit, documented reason not to
// (e.g. an admin/audit tool that intentionally needs to see hidden rows).
// =============================================================================
model CharacterMedia {
  id          String             @id @default(uuid())
  characterId String
  kind        CharacterMediaKind
  url         String
  // Primary image = the avatar shown on cards. Exactly one per character is
  // expected to be true, enforced by the seed/writer, not the DB.
  isPrimary   Boolean            @default(false)
  // Free/public image: the one shown on cards, avatars, chat-top, landing.
  // Exactly one per character is expected to be true (writer-enforced, like
  // isPrimary). Decoupled from isPrimary so the hero/paywalled asset and the
  // free/display asset can be different rows.
  isDisplay   Boolean            @default(false)
  // Weekly-curated lead image. Exactly one per character (writer-enforced by
  // packages/database/prisma/promote-main-images.ts). When set, this row
  // wins over isDisplay/isPrimary/sort in every read site's ordering so the
  // lead never re-elects when new chat-generated images arrive. Locked
  // decision, see Plans/cursor-prompt/35-major-fixes-batch.md #B/#9.
  isMain      Boolean            @default(false)
  // Retired-but-preserved flag. See the HIDDEN MEDIA CONVENTION block above
  // the model: hidden rows stay in the database (and their backing file stays
  // in S3/disk) forever for audit/history, but must never be read by any
  // display query. Default false so every pre-existing and newly written row
  // is visible unless explicitly hidden.
  hidden      Boolean            @default(false)
  // Optional caption/title for videos (and future images).
  title       String?
  // Seed like count for video reels; per-user ReelLike rows are added on top.
  likesBase   Int                @default(0)
  sort        Int                @default(0)
  createdAt   DateTime           @default(now())
  character   Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, kind])
  @@index([kind])
  @@index([characterId, isDisplay])
  @@index([characterId, isMain])
  @@index([characterId, hidden])
}

// =============================================================================
// Phase 30: memory graph (entities + edges) and user rulebook
// =============================================================================
//
// Lineage: this graph design descends from Supermemory (typed-relation graph,
// entity nodes) and Mem0 (extract-then-consolidate memory layer with graph
// links). Poppy already implements the extract stage (Phase 05, model
// Memory); these two models add the link + consolidate stage on top, additive
// and local-only, ported from the sibling Pellow project.
//
// `sourceId` / `targetId` on MemoryEdge reference Memory.id but are
// INTENTIONALLY NOT declared as foreign keys. Pellow keeps this reference
// loose so that pruning/tiering a memory never cascade-deletes an edge; a
// dangling edge is swept in a later maintenance pass instead. Poppy mirrors
// this. Every row also carries BOTH userId AND characterId (unlike Pellow,
// which is single-companion and keys by userId alone): this pair is the
// isolation boundary so a fact/entity for character A never surfaces for
// character B, same user.

// A stable person (or other entity kind) that recurs across a user's
// memories for one character, e.g. "Sam, the user's sister". Upserted by the
// extractor (see llm/memory-extractor.ts) on (userId, characterId, kind,
// normalizedName) so naming the same person twice never creates a duplicate.
model MemoryEntity {
  id             String   @id @default(uuid())
  userId         String
  characterId    String
  kind           String   @default("person")
  name           String
  normalizedName String
  relation       String?
  sentiment      Float?
  aliases        String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  edges MemoryEdge[]

  @@unique([userId, characterId, kind, normalizedName])
  @@index([userId, characterId, kind])
}

// A typed relation between two memories, or between a memory and an entity.
// relation is one of "about_person" (memory -> entity), "extends" (memory ->
// nearest vector neighbor memory), or "derives" (dreaming-derived insight ->
// cluster member). Nullable targetId means multiple NULL-targetId rows can
// share the same (sourceId, relation) under Postgres NULL-distinct unique
// semantics, matching Pellow.
model MemoryEdge {
  id          String   @id @default(uuid())
  userId      String
  characterId String
  sourceId    String
  targetId    String?
  entityId    String?
  relation    String
  weight      Float    @default(0.5)
  label       String?
  createdBy   String   @default("extraction")
  createdAt   DateTime @default(now())

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity MemoryEntity? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relation])
  @@index([userId, characterId, sourceId])
  @@index([userId, characterId, targetId])
  @@index([entityId])
}

// =============================================================================
// Gallery unlock: permanent per-user unlock of a locked CharacterMedia row.
// Spending 1 image token permanently unlocks the image for that user.
// Idempotent: a second unlock attempt on the same row is a no-op (no second
// token deducted). Referenced by the private content gallery page and the
// gallery unlock API route.
// =============================================================================

model UserUnlockedMedia {
  id              String   @id @default(uuid())
  userId          String
  characterMediaId String
  unlockedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, characterMediaId])
  @@index([userId])
}

// Phase 30: user-set conversational rulebook, ported from Pellow's
// UserRule table. getActiveRules() feeds an OWNER RULES prompt layer.
// Keyed by (userId, characterId) since poppy is multi-character (Pellow
// keys by userId alone).
model UserRule {
  id              String   @id @default(uuid())
  userId          String
  characterId     String
  ruleText        String
  instruction     String
  sourceMessageId String?
  status          String   @default("active")
  timesReinforced Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, characterId, status])
}
