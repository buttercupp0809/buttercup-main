# Backend + shared-DB environment template. Copy to backend/.env and fill in.
# SHARED WITH FRONTEND: keep DATABASE_URL and JWT_SECRET identical to
# frontend/.env.local (Next API routes use the DB and verify JWTs).

NODE_ENV=development
PORT=4000

# CORS: origins the browser is allowed to call this server from directly
# (BillingClient, media, chat-stream all fetch this backend with
# credentials: "include"). Comma separated. Defaults to the local frontend
# dev origin (http://localhost:3000) if unset.
CORS_ALLOWED_ORIGINS=

# Database (also used by Prisma migrate/seed/generate and by tests)
DATABASE_URL="postgresql://postgres@localhost:5432/buttercupp_dev?sslmode=disable"
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/buttercupp_test?sslmode=disable"

# Auth (shared with frontend)
JWT_SECRET="change-me-32-chars-min"

# Queue / cache
REDIS_URL="redis://localhost:6379"
MEDIA_WORKER_CONCURRENCY=2
# Media queue backpressure. Caps how many media jobs START per window so a
# burst does not flood the single self-hosted GPU (which serves one image at a
# time) and cascade into poll timeouts. Defaults: 12 jobs / 60000ms. Raise for
# more GPU/managed capacity; lower if the managed fallbacks rate-limit you.
MEDIA_WORKER_RATE_MAX=12
MEDIA_WORKER_RATE_DURATION_MS=60000

# LLM providers
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Self-hosted GPU box (poppy-inference: Stheno text + Juggernaut image).
# Scale-to-zero: set POPPY_ROUTER_URL/TOKEN to auto-wake the box on demand
# (production). OR set the POPPY_*_URL static overrides to skip the router
# (box pinned on / local test). If none are set, chat + image fall back to the
# cloud providers above. See Plans/inference-aws/.
POPPY_ROUTER_URL=
POPPY_ROUTER_TOKEN=
# Static overrides (host:port, no path). Optional; win over the router.
POPPY_STHENO_URL=
POPPY_JUGGERNAUT_URL=
# llama.cpp accepts any key; model name is cosmetic (GGUF loaded is fixed).
POPPY_API_KEY=
POPPY_CHAT_MODEL=
# Override if the ComfyUI checkpoint filename differs from the default.
POPPY_JUGGERNAUT_CHECKPOINT=

# Voice (TTS)
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
GOOGLE_TTS_API_KEY=

# Image generation
FAL_KEY=
REPLICATE_API_TOKEN=

# Video generation (reuses FAL_KEY / REPLICATE_API_TOKEN above).
# Leave the model slugs blank to run the dev stub; fill them to enable real
# text-to-video generation. Examples in backend/src/media/video/constants.ts.
FAL_VIDEO_MODEL=
REPLICATE_VIDEO_MODEL=

# Storage (S3 + CloudFront)
# Leave S3_ENDPOINT empty to use real AWS S3; set it to a MinIO/LocalStack URL
# for a fully local object store. POPPY_DISABLE_S3_UPLOAD=true makes generated
# images return inline as base64 (no S3 write) while reads still hit real S3,
# so local dev can read prod reference images without polluting the bucket.
POPPY_DISABLE_S3_UPLOAD=""
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Generated character/user images bucket (images/* keys). Falls back to S3_BUCKET when unset.
POPPY_S3_BUCKET_GENERATED=
# Reels mp4 bucket (reels/* keys). Locally defaults to the shared "poppy-reels" bucket.
POPPY_S3_BUCKET_REELS=poppy-reels
S3_ENDPOINT=
CLOUDFRONT_URL=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# Payments (adult-friendly processors only; never Stripe for mature).
# Phase 27: CCBill primary, SegPay fallback, Verotel third, crypto for
# one-time token packs only (see Plans/cursor-prompt/27-payments-checkout.md
# "Processor recommendation"). All values below are SANDBOX/TEST-MODE
# placeholders, left empty. Real (sandbox or live) keys are set out of band
# in an untracked local .env and require explicit human approval before use;
# never commit a real key here. Adapters no-op (isConfigured() -> false) when
# their keys are unset, so local dev + tests run fine with everything blank.
PAYMENT_PRIMARY_PROVIDER="dodo"
CCBILL_ACCOUNT_NUMBER=
CCBILL_FLEXFORM_ID=
CCBILL_DATALINK_SALT=
VEROTEL_SHOP_ID=
VEROTEL_SIGNATURE_KEY=
SEGPAY_PACKAGE_ID=
SEGPAY_URL_ID=
SEGPAY_HMAC_KEY=
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=
# Dodo Payments (Phase 32). Merchant-of-Record hosted checkout used as the
# primary processor. DODO_API_KEY = bearer token; DODO_WEBHOOK_KEY = the
# Standard-Webhooks signing key from the Dodo dashboard. DODO_ENVIRONMENT is
# test_mode or live_mode. DODO_PRODUCT_* map ButterCupp's 3 duration passes
# (daily/weekly/monthly) and 3 token packs (pack_100/pack_500/pack_2000) to
# the corresponding Dodo product ids. Missing product ids fail LOUD at
# checkout (see backend/src/payments/dodo.ts:resolveProductId), never silently.
DODO_API_KEY=
DODO_WEBHOOK_KEY=
DODO_ENVIRONMENT=test_mode
DODO_PRODUCT_DAILY=
DODO_PRODUCT_WEEKLY=
DODO_PRODUCT_MONTHLY=
DODO_PRODUCT_PACK_100=
DODO_PRODUCT_PACK_500=
DODO_PRODUCT_PACK_2000=
# Recurring subscription products (Phase 33). ButterCupp's monthly and yearly
# auto-renewing tiers. Configure these as SUBSCRIPTION products in the Dodo
# dashboard (one-time PASS products above stay as one-time). Missing ids fail
# LOUD at checkout via resolveProductId.
DODO_PRODUCT_SUB_MONTHLY=
DODO_PRODUCT_SUB_YEARLY=

# Observability
SENTRY_DSN=

# Feature flags
MATURE_CONTENT_ENABLED=true
