# Frontend environment template. Copy to frontend/.env.local and fill in.
# SHARED WITH BACKEND: keep DATABASE_URL and JWT_SECRET identical to backend/.env.

# Shared server secrets (used by app/api/* route handlers)
DATABASE_URL="postgresql://postgres@localhost:5432/buttercupp_dev?sslmode=disable"
JWT_SECRET="change-me-32-chars-min"

# How the browser + server reach the backend API / WebSocket gateway
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BACKEND_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000/ws"
BACKEND_URL="http://localhost:4000"

# Media CDN. In production set all three so lib/cdn.ts signs CloudFront URLs
# directly. If CLOUDFRONT_URL is empty, images fall back to the /api/media
# proxy, which instead needs AWS_REGION + S3_BUCKET + POPPY_S3_BUCKET_GENERATED
# (below) plus AWS credentials available to the SSR runtime.
CLOUDFRONT_URL=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# S3 (used by the /api/media proxy + server-side blur when CloudFront is off).
AWS_REGION="eu-north-1"
S3_BUCKET="poppy-character-media"
POPPY_S3_BUCKET_GENERATED="poppy-generated"

# Google OAuth. Same GIS client id, both server- and client-side. The server
# route /api/auth/oauth/google verifies the ID token audience against
# GOOGLE_CLIENT_ID; when it is unset the route returns 501 and the frontend
# GoogleButton hides itself (email+password signup keeps working). The
# NEXT_PUBLIC_* copy is required to render the GIS button in the browser.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Age verification
AGE_VERIFICATION_PROVIDER="self_declared"
AGE_VENDOR_API_KEY=

# Observability (optional)
NEXT_PUBLIC_SENTRY_DSN=

# Transactional email (password reset + welcome). Without RESEND_API_KEY the
# app logs emails to the server console (dev fallback) so the flow still works.
RESEND_API_KEY=
EMAIL_FROM="ButterCupp <onboarding@resend.dev>"
