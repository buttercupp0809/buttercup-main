# Backend (ECS) secrets template.
#
# Copy to `secrets.env` (git-ignored), fill values, then run:
#   ./03-provision-secrets.sh          # creates buttercupp/<KEY> in Secrets Manager
#   ./13-set-env-vars.sh secrets.env   # to update after launch
#
# IMPORTANT: every key below is referenced by infra/ecs/task-api.json or
# task-worker.json. ECS will REFUSE to start a task if a referenced secret does
# not exist, so keep ALL keys here (leave optional ones blank, but present).
#
# ---- Required for the app to boot ----
DATABASE_URL=postgresql://buttercupp_admin:CHANGE_ME@REPLACE-RDS-ENDPOINT:5432/buttercupp?sslmode=require
JWT_SECRET=CHANGE_ME_32_CHARS_MIN_matches_amplify
REDIS_URL=redis://REPLACE-REDIS-ENDPOINT:6379
AWS_REGION=eu-north-1
S3_BUCKET=poppy-character-media
POPPY_S3_BUCKET_GENERATED=poppy-generated
POPPY_S3_BUCKET_REELS=poppy-reels

# ---- CloudFront signed image URLs (from 04-provision-cloudfront.sh) ----
# CLOUDFRONT_URL = https://<dist>.cloudfront.net (no trailing slash)
# CLOUDFRONT_PRIVATE_KEY = the PEM contents of cf_private.pem (newlines as real
# newlines are fine inside a Secrets Manager value).
CLOUDFRONT_URL=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# ---- LLM (at least OPENROUTER_API_KEY, or the self-hosted POPPY_* below) ----
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Self-hosted inference (chat + character-consistent image gen) ----
POPPY_ROUTER_URL=
POPPY_ROUTER_TOKEN=
POPPY_STHENO_URL=
POPPY_JUGGERNAUT_URL=

# ---- Media generation providers (optional fallbacks) ----
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
GOOGLE_TTS_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=

# ---- Payments (fill the provider you use; keep the rest present but blank) ----
PAYMENT_PRIMARY_PROVIDER=ccbill
CCBILL_ACCOUNT_NUMBER=
CCBILL_FLEXFORM_ID=
CCBILL_DATALINK_SALT=
VEROTEL_SHOP_ID=
VEROTEL_SIGNATURE_KEY=
SEGPAY_PACKAGE_ID=
SEGPAY_URL_ID=
SEGPAY_HMAC_KEY=
COINBASE_COMMERCE_API_KEY=

# ---- Misc ----
MATURE_CONTENT_ENABLED=true
SENTRY_DSN=
