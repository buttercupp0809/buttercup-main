# ButterCupp AWS deployment config. Sourced by every script through lib.sh.
#
# Values are grouped into: (a) stable constants you rarely change, and
# (b) a "FILL AFTER PROVISION" block that the provisioning scripts print for
# you to paste back in as each resource is created. Nothing here is a secret;
# real secrets live in Secrets Manager (see 03-provision-secrets.sh) and in
# secrets.env (git-ignored), never in this file.

# ---- Identity / region ------------------------------------------------------
export AWS_REGION="eu-north-1"            # core region: ECS, RDS, Redis, ECR, ALB, S3
export CLOUDFRONT_ACM_REGION="us-east-1"  # CloudFront ACM certs MUST live in us-east-1
export AWS_ACCOUNT_ID="${AWS_ACCOUNT_ID:-}"  # auto-derived by lib.sh (aws sts) when empty

# ---- Domain / DNS -----------------------------------------------------------
export ROOT_DOMAIN="buttercupp.fun"
export FRONTEND_HOST="www.buttercupp.fun"     # Amplify serves this; apex redirects here
export API_HOST="api.buttercupp.fun"          # ALB -> ECS api service (HTTP + /ws)
export MEDIA_HOST="media.buttercupp.fun"      # optional CNAME to CloudFront (else use the cloudfront.net domain)

# ---- Naming -----------------------------------------------------------------
export PROJECT="buttercupp"
export ECR_REPO="buttercupp"
export ECS_CLUSTER="buttercupp-prod"
export ECS_SERVICE_API="buttercupp-api"
export ECS_SERVICE_WORKER="buttercupp-worker"
export TASK_FAMILY_API="buttercupp-api"
export TASK_FAMILY_WORKER="buttercupp-worker"
export LOG_GROUP_API="/ecs/buttercupp-api"
export LOG_GROUP_WORKER="/ecs/buttercupp-worker"
export SECRET_PREFIX="buttercupp"             # per-key secrets: buttercupp/<VAR>
export CONTAINER_PORT="4000"
export HEALTH_PATH="/healthz"

# ---- S3 buckets (already exist) ---------------------------------------------
export S3_BUCKET="poppy-character-media"
export S3_BUCKET_GENERATED="poppy-generated"
export S3_BUCKET_REELS="poppy-reels"

# ---- Database (RDS Postgres + pgvector) -------------------------------------
export DB_ENGINE_VERSION="16"
export DB_NAME="buttercupp"
export DB_USER="buttercupp_admin"
export DB_INSTANCE_CLASS="db.t4g.small"
export DB_INSTANCE_ID="buttercupp-prod"
export DB_ALLOCATED_GB="20"

# ---- Redis (ElastiCache) ----------------------------------------------------
export REDIS_NODE_TYPE="cache.t4g.small"
export REDIS_CLUSTER_ID="buttercupp-prod"

# ---- Fargate sizing ---------------------------------------------------------
export API_CPU="1024";    export API_MEMORY="2048";    export API_DESIRED="2"
export WORKER_CPU="1024"; export WORKER_MEMORY="2048"; export WORKER_DESIRED="1"

# ---- Amplify (frontend) -----------------------------------------------------
export AMPLIFY_REGION="eu-north-1"            # Next.js SSR (WEB_COMPUTE) runs in-region
export AMPLIFY_BRANCH="main"
export GITHUB_REPO_URL="https://github.com/buttercupp0809/buttercup-main"

# =============================================================================
# FILL AFTER PROVISION  (each provisioning script prints the value to paste here)
# =============================================================================
# Networking (from 01-provision-foundation.sh)
export VPC_ID="${VPC_ID:-vpc-0fde263c0fdbda1f9}"
export SUBNET_IDS="${SUBNET_IDS:-subnet-000a5291789433865,subnet-071e71ecac3cce4a7,subnet-0d09f887033170818}"               # comma-separated, 2+ AZs (tasks + data)
export PUBLIC_SUBNET_IDS="${PUBLIC_SUBNET_IDS:-subnet-000a5291789433865,subnet-071e71ecac3cce4a7,subnet-0d09f887033170818}" # comma-separated, for the public ALB
export SG_ALB="${SG_ALB:-sg-05f1e6b790f33ccfe}"
export SG_ECS="${SG_ECS:-sg-02578bc388a458fed}"
export SG_RDS="${SG_RDS:-sg-04a5764b7f084e4a4}"
export SG_REDIS="${SG_REDIS:-sg-0842fd656f34ea9ef}"

# Data (from 02-provision-data.sh)
export RDS_ENDPOINT="${RDS_ENDPOINT:-buttercupp-prod.cfkeo6yq0wzt.eu-north-1.rds.amazonaws.com}"           # host only, no port
export REDIS_ENDPOINT="${REDIS_ENDPOINT:-buttercupp-prod.mex2pu.0001.eun1.cache.amazonaws.com}"       # primary endpoint host

# CloudFront (from 04-provision-cloudfront.sh)
export CLOUDFRONT_DIST_ID="${CLOUDFRONT_DIST_ID:-E16J8VMOF8ZHT2}"
export CLOUDFRONT_DOMAIN="${CLOUDFRONT_DOMAIN:-dtoyxhtui7a4s.cloudfront.net}" # dXXXX.cloudfront.net (becomes CLOUDFRONT_URL)
export CLOUDFRONT_KEY_PAIR_ID="${CLOUDFRONT_KEY_PAIR_ID:-K2ZCHNZY2EZAMR}"

# ALB (from 05-provision-alb.sh)
export ALB_ARN="${ALB_ARN:-arn:aws:elasticloadbalancing:eu-north-1:014468369350:loadbalancer/app/buttercupp-alb/908e211a408ed691}"
export ALB_DNS="${ALB_DNS:-buttercupp-alb-1608122244.eu-north-1.elb.amazonaws.com}"
export TG_API_ARN="${TG_API_ARN:-arn:aws:elasticloadbalancing:eu-north-1:014468369350:targetgroup/buttercupp-api/cf5f19a2a36093b8}"

# Amplify (from 07-provision-amplify.sh)
export AMPLIFY_APP_ID="${AMPLIFY_APP_ID:-d2qltioisxx75j}"
