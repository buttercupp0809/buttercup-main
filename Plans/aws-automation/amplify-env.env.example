# Frontend (Amplify) environment template.
#
# Copy to `amplify-env.env` (git-ignored), fill values, then run:
#   ./07-provision-amplify.sh    # writes these into the Amplify app env
# (or paste them into the Amplify console -> App settings -> Environment variables).
#
# These reach the Next.js SSR runtime via frontend/instrumentation.ts, which
# loads .next/server-env.json (baked by amplify.yml) into process.env.
# NEXT_PUBLIC_* values are ALSO inlined into the browser bundle at build time.

NODE_ENV=production

# Shared with backend (must be byte-identical to the ECS DATABASE_URL / JWT_SECRET)
DATABASE_URL=postgresql://buttercupp_admin:CHANGE_ME@REPLACE-RDS-ENDPOINT:5432/buttercupp?sslmode=require
JWT_SECRET=CHANGE_ME_32_CHARS_MIN_matches_ecs

# Public URLs (browser + server). Backend + WebSocket live on the ALB subdomain.
NEXT_PUBLIC_APP_URL=https://www.buttercupp.fun
NEXT_PUBLIC_BACKEND_URL=https://api.buttercupp.fun
NEXT_PUBLIC_WS_URL=wss://api.buttercupp.fun/ws
BACKEND_URL=https://api.buttercupp.fun

# CloudFront signed image URLs (from 04-provision-cloudfront.sh). With these set,
# lib/cdn.ts signs CloudFront URLs directly (no /api/media proxy).
CLOUDFRONT_URL=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# S3 (fallback proxy + server-side blur when CloudFront is off).
AWS_REGION=eu-north-1
S3_BUCKET=poppy-character-media
POPPY_S3_BUCKET_GENERATED=poppy-generated

# Optional
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
AGE_VERIFICATION_PROVIDER=self_declared
RESEND_API_KEY=
EMAIL_FROM=ButterCupp <noreply@buttercupp.fun>
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
