{
  "_comment": "ECS Fargate task for the API + WebSocket gateway (PROCESS_ROLE=api). Every value marked ACCOUNT/REGION/ACCT_ID is a placeholder; replace during human-approved provisioning. Secrets are pulled from SSM/Secrets Manager by ARN and MUST NEVER be inlined here.",
  "family": "buttercupp-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "X86_64"
  },
  "executionRoleArn": "arn:aws:iam::ACCT_ID:role/buttercupp-ecs-execution",
  "taskRoleArn": "arn:aws:iam::ACCT_ID:role/buttercupp-api-task",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "ACCT_ID.dkr.ecr.REGION.amazonaws.com/buttercupp:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 4000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PROCESS_ROLE",
          "value": "api"
        },
        {
          "name": "PORT",
          "value": "4000"
        },
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "FRONTEND_URL",
          "value": "https://www.buttercupp.fun"
        },
        {
          "name": "CORS_ALLOWED_ORIGINS",
          "value": "https://www.buttercupp.fun,https://buttercupp.fun"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/DATABASE_URL"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/JWT_SECRET"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/REDIS_URL"
        },
        {
          "name": "OPENROUTER_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/OPENROUTER_API_KEY"
        },
        {
          "name": "S3_BUCKET",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/S3_BUCKET"
        },
        {
          "name": "POPPY_S3_BUCKET_GENERATED",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/POPPY_S3_BUCKET_GENERATED"
        },
        {
          "name": "POPPY_S3_BUCKET_REELS",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/POPPY_S3_BUCKET_REELS"
        },
        {
          "name": "AWS_REGION",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/AWS_REGION"
        },
        {
          "name": "CLOUDFRONT_URL",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/CLOUDFRONT_URL"
        },
        {
          "name": "CLOUDFRONT_KEY_PAIR_ID",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/CLOUDFRONT_KEY_PAIR_ID"
        },
        {
          "name": "CLOUDFRONT_PRIVATE_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/CLOUDFRONT_PRIVATE_KEY"
        },
        {
          "name": "PAYMENT_PRIMARY_PROVIDER",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/PAYMENT_PRIMARY_PROVIDER"
        },
        {
          "name": "MATURE_CONTENT_ENABLED",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/MATURE_CONTENT_ENABLED"
        },
        {
          "name": "POPPY_ROUTER_URL",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/POPPY_ROUTER_URL"
        },
        {
          "name": "POPPY_ROUTER_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/POPPY_ROUTER_TOKEN"
        },
        {
          "name": "POPPY_STHENO_URL",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/POPPY_STHENO_URL"
        },
        {
          "name": "POPPY_JUGGERNAUT_URL",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/POPPY_JUGGERNAUT_URL"
        },
        {
          "name": "DODO_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/DODO_API_KEY"
        },
        {
          "name": "DODO_WEBHOOK_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/DODO_WEBHOOK_KEY"
        },
        {
          "name": "DODO_ENVIRONMENT",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/DODO_ENVIRONMENT"
        },
        {
          "name": "DODO_PRODUCT_DAILY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/DODO_PRODUCT_DAILY"
        },
        {
          "name": "DODO_PRODUCT_WEEKLY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/DODO_PRODUCT_WEEKLY"
        },
        {
          "name": "DODO_PRODUCT_MONTHLY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/DODO_PRODUCT_MONTHLY"
        },
        {
          "name": "DODO_PRODUCT_PACK_100",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/DODO_PRODUCT_PACK_100"
        },
        {
          "name": "DODO_PRODUCT_PACK_500",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/DODO_PRODUCT_PACK_500"
        },
        {
          "name": "DODO_PRODUCT_PACK_2000",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:buttercupp/DODO_PRODUCT_PACK_2000"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"fetch('http://127.0.0.1:4000/healthz').then(r=>r.ok?process.exit(0):process.exit(1)).catch(()=>process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/buttercupp-api",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "api",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
