{
  "_comment": "ECS Fargate task for the API + WebSocket gateway (PROCESS_ROLE=api). Every value marked ACCOUNT/REGION/ACCT_ID is a placeholder; replace during human-approved provisioning. Secrets are pulled from SSM/Secrets Manager by ARN and MUST NEVER be inlined here.",
  "family": "poppy-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "runtimePlatform": { "operatingSystemFamily": "LINUX", "cpuArchitecture": "X86_64" },
  "executionRoleArn": "arn:aws:iam::ACCT_ID:role/poppy-ecs-execution",
  "taskRoleArn": "arn:aws:iam::ACCT_ID:role/poppy-api-task",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "ACCT_ID.dkr.ecr.REGION.amazonaws.com/poppy:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 4000, "protocol": "tcp" }],
      "environment": [
        { "name": "PROCESS_ROLE", "value": "api" },
        { "name": "PORT", "value": "4000" },
        { "name": "NODE_ENV", "value": "production" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/DATABASE_URL" },
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/JWT_SECRET" },
        { "name": "REDIS_URL", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/REDIS_URL" },
        { "name": "OPENROUTER_API_KEY", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/OPENROUTER_API_KEY" },
        { "name": "ANTHROPIC_API_KEY", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/ANTHROPIC_API_KEY" },
        { "name": "OPENAI_API_KEY", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/OPENAI_API_KEY" },
        { "name": "ELEVENLABS_API_KEY", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/ELEVENLABS_API_KEY" },
        { "name": "CARTESIA_API_KEY", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/CARTESIA_API_KEY" },
        { "name": "GOOGLE_TTS_API_KEY", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/GOOGLE_TTS_API_KEY" },
        { "name": "FAL_KEY", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/FAL_KEY" },
        { "name": "REPLICATE_API_TOKEN", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/REPLICATE_API_TOKEN" },
        { "name": "S3_BUCKET", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/S3_BUCKET" },
        { "name": "AWS_REGION", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/AWS_REGION" },
        { "name": "CLOUDFRONT_URL", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/CLOUDFRONT_URL" },
        { "name": "CLOUDFRONT_KEY_PAIR_ID", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/CLOUDFRONT_KEY_PAIR_ID" },
        { "name": "CLOUDFRONT_PRIVATE_KEY", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/CLOUDFRONT_PRIVATE_KEY" },
        { "name": "CCBILL_ACCOUNT_NUMBER", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/CCBILL_ACCOUNT_NUMBER" },
        { "name": "CCBILL_FLEXFORM_ID", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/CCBILL_FLEXFORM_ID" },
        { "name": "CCBILL_DATALINK_SALT", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/CCBILL_DATALINK_SALT" },
        { "name": "VEROTEL_SHOP_ID", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/VEROTEL_SHOP_ID" },
        { "name": "VEROTEL_SIGNATURE_KEY", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/VEROTEL_SIGNATURE_KEY" },
        { "name": "SEGPAY_PACKAGE_ID", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/SEGPAY_PACKAGE_ID" },
        { "name": "SEGPAY_URL_ID", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/SEGPAY_URL_ID" },
        { "name": "SEGPAY_HMAC_KEY", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/SEGPAY_HMAC_KEY" },
        { "name": "SENTRY_DSN", "valueFrom": "arn:aws:secretsmanager:REGION:ACCT_ID:secret:poppy/SENTRY_DSN" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "node -e \"fetch('http://127.0.0.1:4000/healthz').then(r=>r.ok?process.exit(0):process.exit(1)).catch(()=>process.exit(1))\""],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/poppy-api",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "api",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
